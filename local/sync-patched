#!/usr/bin/env python3
"""Merge upstream into patched, validate, install the binary pair, and clean builds."""
import argparse
import hashlib
import json
import os
from pathlib import Path
import shutil
import stat
import subprocess
import tempfile
import tomllib

ROOT = Path(__file__).resolve().parent.parent


def run(args, *, env=None, capture=False, check=True):
    return subprocess.run(args, cwd=ROOT, env=env, text=True, check=check,
                          stdout=subprocess.PIPE if capture else None)


def git(*args):
    return run(["git", *args], capture=True).stdout.strip()


def digest(path):
    with path.open("rb") as source:
        return hashlib.file_digest(source, "sha256").hexdigest()


def remove_readonly(function, path, _error):
    os.chmod(path, stat.S_IRWXU)
    function(path)


def install(env, cargo, build, commit):
    stage = build / "stage"
    run([cargo, "install", "--path", str(ROOT), "--locked", "--force", "--root", str(stage)], env=env)
    if git("rev-parse", "HEAD") != commit or git("status", "--porcelain"):
        raise RuntimeError("source changed during the release build")
    names = ("kache", "kache-engine")
    suffix = ".exe" if os.name == "nt" else ""
    hashes = {name: digest(stage / "bin" / (name + suffix)) for name in names}
    expected = "kache " + env["KACHE_VERSION"]
    for name in names:
        version = run([str(stage / "bin" / (name + suffix)), "--version"], env=env, capture=True).stdout.strip()
        if version != expected:
            raise RuntimeError(f"{name} reported {version!r}, expected {expected!r}")
    home = Path(os.environ.get("CARGO_INSTALL_ROOT") or os.environ.get("CARGO_HOME") or Path.home() / ".cargo")
    installed = home / "bin" / ("kache" + suffix)
    backup = build / "rollback"
    backup.mkdir()
    paths = [Path("bin") / (name + suffix) for name in names] + [Path(".crates.toml"), Path(".crates2.json")]
    for relative in paths:
        source = home / relative
        if source.exists():
            target = backup / relative
            target.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(source, target)
    if installed.exists():
        run([str(installed), "daemon", "stop"], env=env)
    try:
        run([cargo, "install", "--path", str(ROOT), "--locked", "--force", "--root", str(home)], env=env)
        for name in names:
            if digest(home / "bin" / (name + suffix)) != hashes[name]:
                raise RuntimeError(f"installed {name} differs from the staged build")
        run([str(installed), "daemon", "restart"], env=env)
        # Report the user's configuration, not the temporary build overrides.
        runtime_env = os.environ.copy()
        report = json.loads(run([str(installed), "doctor", "--probe", "--json"], env=runtime_env, capture=True).stdout)
        if report["issues"] or not next(c for c in report["checks"] if c["label"] == "Cache probe")["pass"]:
            raise RuntimeError("post-install doctor failed: " + json.dumps(report))
    except BaseException:
        if installed.exists():
            run([str(installed), "daemon", "stop"], env=env, check=False)
        for relative in paths:
            source = backup / relative
            target = home / relative
            if source.exists():
                temporary = target.with_name(target.name + ".rollback")
                shutil.copy2(source, temporary)
                os.replace(temporary, target)
            elif target.exists():
                target.unlink()
        if installed.exists():
            run([str(installed), "daemon", "start"], env=env, check=False)
        raise
    receipt = {
        "source_commit": commit,
        "upstream_commit": git("rev-parse", "upstream/main"),
        "version": env["KACHE_VERSION"],
        "sha256": hashes,
        "validation": {"just_check": "passed", "doctor_issues": report["issues"], "cache_probe": "passed"},
    }
    (ROOT / "local" / "installed.json").write_text(json.dumps(receipt, indent=2) + "\n")
    run(["git", "add", "local/installed.json"])
    if run(["git", "diff", "--cached", "--quiet"], check=False).returncode:
        run(["git", "commit", "-m", f"Record verified patched installation {commit[:12]}"])


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--push", action="store_true", help="push patched to origin after success (no force)")
    parser.add_argument("--no-sync", action="store_true", help="validate/rebuild the current commit without fetching or merging")
    parser.add_argument("--no-install", action="store_true", help="validate the source without building/installing a release")
    parser.add_argument("--no-check", action="store_true", help="merge only; requires --no-install")
    args = parser.parse_args()
    if args.no_check and not args.no_install:
        parser.error("--no-check requires --no-install; installation always requires validation")
    if git("branch", "--show-current") != "patched":
        raise RuntimeError("run this from the patched branch")
    if git("status", "--porcelain"):
        raise RuntimeError("commit existing changes before syncing; this tool never stashes or resets them")
    if run(["git", "rev-parse", "--verify", "-q", "MERGE_HEAD"], capture=True, check=False).returncode == 0:
        raise RuntimeError("finish the existing merge before syncing")
    run(["git", "config", "rerere.enabled", "true"])
    if not args.no_sync:
        run(["git", "fetch", "origin", "patched"])
        run(["git", "merge", "--ff-only", "origin/patched"])
        run(["git", "fetch", "upstream", "main", "--tags"])
        # Preserve every local fix, including closed/unsubmitted PRs. Conflicts
        # remain visible for a human to resolve; no patch is silently skipped.
        run(["git", "merge", "--no-edit", "upstream/main"])
    commit = git("rev-parse", "HEAD")
    if not args.no_check:
        cargo = run(["rustup", "which", "cargo"], capture=True).stdout.strip()
        rustdoc = run(["rustup", "which", "rustdoc"], capture=True).stdout.strip()
        parent = os.environ.get("KACHE_SYNC_BUILD_ROOT") or tempfile.gettempdir()
        build = Path(tempfile.mkdtemp(prefix="kache-sync-", dir=parent))
        try:
            env = os.environ.copy()
            env.update(PATH=str(Path(cargo).parent) + os.pathsep + env["PATH"],
                       RUSTC_WRAPPER="", RUSTC_WORKSPACE_WRAPPER="", RUSTDOC=rustdoc,
                       KACHE_TEST_USE_CARGO_BIN_EXE="1", HOST_CC="cc", HOST_CXX="c++",
                       CARGO_TARGET_DIR=str(build / "target"),
                       CARGO_BUILD_BUILD_DIR=str(build / "intermediates"))
            run(["just", "check"], env=env)
            if git("rev-parse", "HEAD") != commit or git("status", "--porcelain"):
                raise RuntimeError("source changed during validation")
            if not args.no_install:
                version = tomllib.loads((ROOT / "Cargo.toml").read_text())["package"]["version"]
                env["KACHE_VERSION"] = f"{version}+patched.{commit[:12]}"
                install(env, cargo, build, commit)
        finally:
            shutil.rmtree(build, onerror=remove_readonly)
    if args.push:
        run(["git", "push", "origin", "HEAD:refs/heads/patched"])
    print("patched:", git("rev-parse", "HEAD"))


if __name__ == "__main__":
    main()
