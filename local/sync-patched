#!/usr/bin/env bash
# Rebuild the local `patched` branch: upstream main plus every open PR by the author
# and every branch in local/extra-branches,
# then check and install it. Conflicts that rerere has seen before resolve themselves;
# a PR with a new conflict is skipped and listed at the end.
#
# Lives in the main checkout under local/, which .git/info/exclude keeps out of commits.
#
# Usage: local/sync-patched [--no-check] [--no-install]
set -euo pipefail

REPO="$(cd "$(dirname "$0")/.." && pwd)"
WORKTREE="$(dirname "$REPO")/kache-patched"
UPSTREAM="kunobi-ninja/kache"
AUTHOR="viktorius007"
STATE="$HOME/.local/state/kache-patched"

check=1 install=1
for arg in "$@"; do
  case "$arg" in
    --no-check) check=0 ;;
    --no-install) install=0 ;;
    *) echo "unknown option: $arg" >&2; exit 2 ;;
  esac
done

cd "$WORKTREE"
if [ -n "$(git status --porcelain)" ]; then
  echo "$WORKTREE has uncommitted changes; commit or stash them first." >&2
  exit 1
fi
if [ "$(git config --get rerere.enabled)" != "true" ]; then
  echo "rerere is off; run: git config rerere.enabled true && git config rerere.autoupdate true" >&2
  exit 1
fi

prs=$(gh pr list -R "$UPSTREAM" --author "$AUTHOR" --state open --limit 200 \
  --json number,title --jq 'sort_by(.number) | .[] | "\(.number)\t\(.title)"')
refspecs=$(cut -f1 <<<"$prs" | sed 's#.*#+refs/pull/&/head:refs/remotes/pr/&#')
# shellcheck disable=SC2086
git fetch -q origin main $refspecs

previous=$(git rev-parse --short HEAD)
git switch -q -C patched origin/main

merged=() skipped=()
while IFS=$'\t' read -r number title; do
  [ -n "$number" ] || continue
  if git merge -q --no-edit -m "Merge #$number: $title" "pr/$number" >/dev/null 2>&1; then
    merged+=("$number")
  elif [ -z "$(git diff --name-only --diff-filter=U)" ]; then
    git commit -q --no-edit
    merged+=("$number")
  else
    git merge --abort
    skipped+=("$number")
  fi
done <<<"$prs"

# Local fix branches that have no PR yet, one per line in local/extra-branches.
if [ -f "$REPO/local/extra-branches" ]; then
  while read -r branch; do
    [ -n "$branch" ] || continue
    if git merge -q --no-edit -m "Merge local $branch" "$branch" >/dev/null 2>&1; then
      merged+=("$branch")
    elif [ -z "$(git diff --name-only --diff-filter=U)" ]; then
      git commit -q --no-edit
      merged+=("$branch")
    else
      git merge --abort
      skipped+=("$branch")
    fi
  done <"$REPO/local/extra-branches"
fi

echo "upstream main: $(git rev-parse --short origin/main) ($(git describe --tags origin/main))"
echo "patched:       $(git rev-parse --short HEAD) (previous build $previous)"
echo "merged ${#merged[@]}: ${merged[*]}"
if [ ${#skipped[@]} -gt 0 ]; then
  echo "SKIPPED ${#skipped[@]} with new conflicts: ${skipped[*]}"
  echo "  resolve one: git merge pr/<n>, fix the files, git commit (rerere remembers it), then rerun."
fi

if [ "$check" = 1 ]; then
  just check
fi

if [ "$install" = 1 ]; then
  # Build without the installed kache, as the Justfile does.
  RUSTC_WRAPPER= cargo install --path . --locked --force
  kache daemon restart
  mkdir -p "$STATE"
  {
    echo "installed $(date '+%Y-%m-%d %H:%M')"
    echo "commit    $(git rev-parse HEAD)"
    echo "upstream  $(git rev-parse origin/main)"
    echo "merged    ${merged[*]}"
    echo "skipped   ${skipped[*]:-}"
  } >"$STATE/installed.txt"
  echo "installed $(kache --version); record in $STATE/installed.txt"
fi
