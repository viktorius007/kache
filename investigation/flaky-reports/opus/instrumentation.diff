+// FLAKY-INVESTIGATION instrumentation (temporary, not for commit).
+// Computes the known test's cold key under each env state another test in
+// this binary sets, to find which state yields the observed left-hand key.
+#[cfg(unix)]
+#[test]
+fn zz_flaky_probe_states() {
+    if std::env::var_os("FLAKY_PROBE").is_none() {
+        return;
+    }
+    let mut lock = crate::test_support::process_state_test_lock();
+    let dir = tempfile::tempdir().unwrap();
+    let source = dir.path().join("unit.c");
+    fs::write(&source, "int x;\n").unwrap();
+    let fake_cc =
+        Path::new(env!("CARGO_MANIFEST_DIR")).join("tests/fixtures/mock_cc_diagnostics.sh");
+    let compiler = CcCompiler::new();
+    let file_hasher = crate::cache_key::FileHasher::new();
+    let path_normalizer = crate::path_normalizer::PathNormalizer::empty();
+    let n = std::cell::Cell::new(0);
+    let key = |flags: &[&str]| {
+        let mut args = vec![
+            fake_cc.to_string_lossy().into_owned(),
+            "-c".into(),
+            source.to_string_lossy().into_owned(),
+        ];
+        args.extend(flags.iter().map(|flag| flag.to_string()));
+        n.set(n.get() + 1);
+        let cache = dir.path().join(format!("cold-s{}", n.get()));
+        compiler
+            .cache_key(
+                &compiler.parse(&args).unwrap(),
+                &KeyCtx {
+                    file_hasher: &file_hasher,
+                    path_normalizer: &path_normalizer,
+                    cache_dir: &cache,
+                    key_salt: None,
+                    key_env_vars: &[],
+                    extra_inputs_digest: None,
+                    build_script_inputs_digest: None,
+                },
+            )
+            .unwrap()
+    };
+    use crate::config::tests::set_env_for_test as set;
+    let _a = set("OUT_DIR", None);
+    let _b = set("SDKROOT", None);
+    let _c = set("KACHE_CC_PATH_NORMALIZE", None);
+    let _d = set("KACHE_BASE_DIR", None);
+    eprintln!("STATE unset: {}", key(&["-fcolor-diagnostics"]));
+    let t = tempfile::tempdir().unwrap();
+    let tp = t.path();
+    let p = |rel: &str| tp.join(rel);
+    std::fs::create_dir_all(p("target/debug/build/pkg-1/out")).unwrap();
+    std::fs::create_dir_all(p("real/out")).unwrap();
+    std::os::unix::fs::symlink(p("real"), p("link")).unwrap();
+    std::fs::create_dir_all(p("clone-a/target/release/build/libz-sys-1234/out")).unwrap();
+    std::fs::create_dir_all(p("sdk")).unwrap();
+    let states: Vec<(&str, Vec<(&'static str, Option<std::ffi::OsString>)>)> = vec![
+        ("cargo-out", vec![("OUT_DIR", Some("/Users/x/target/debug/build/kache-0123/out".into()))]),
+        ("pkg-out", vec![("OUT_DIR", Some(p("target/debug/build/pkg-1/out").into()))]),
+        ("pkg-out+sdk-missing", vec![("OUT_DIR", Some(p("target/debug/build/pkg-1/out").into())), ("SDKROOT", Some(p("nosdk").into()))]),
+        ("sdk-missing", vec![("SDKROOT", Some(p("nosdk").into()))]),
+        ("sdk-exists", vec![("SDKROOT", Some(p("sdk").into()))]),
+        ("link-out", vec![("OUT_DIR", Some(p("link/out").into()))]),
+        ("clone-a", vec![("OUT_DIR", Some(p("clone-a/target/release/build/libz-sys-1234/out").into())), ("KACHE_BASE_DIR", Some(p("clone-a").into()))]),
+        ("base-only", vec![("KACHE_BASE_DIR", Some(p("clone-a").into()))]),
+        ("t-out", vec![("OUT_DIR", Some(p("out").into()))]),
+        ("slash-t", vec![("OUT_DIR", Some("/t/debug/build/x-1/out".into()))]),
+        ("normalize-0", vec![("KACHE_CC_PATH_NORMALIZE", Some("0".into()))]),
+    ];
+    for (label, vars) in &states {
+        let guards: Vec<_> = vars.iter().map(|(k, v)| set(k, v.as_deref())).collect();
+        eprintln!("STATE {label}: {}", key(&["-fcolor-diagnostics"]));
+        drop(guards);
+    }
+    let entered = lock.enter();
+    for (label, vars) in &states {
+        let guards: Vec<_> = vars.iter().map(|(k, v)| set(k, v.as_deref())).collect();
+        eprintln!("STATE cwd-entered {label}: {}", key(&["-fcolor-diagnostics"]));
+        drop(guards);
+    }
+    // out_dir_and_sdk_maps_follow_... state 1, with its own cwd layout.
+    std::fs::create_dir_all(entered.join("target/debug/build/pkg-1/out")).unwrap();
+    {
+        let _o = set("OUT_DIR", Some(entered.join("target/debug/build/pkg-1/out").as_os_str()));
+        let _s = set("SDKROOT", Some("".as_ref()));
+        eprintln!("STATE cc7975-s1: {}", key(&["-fcolor-diagnostics"]));
+        let _s2 = set("SDKROOT", Some(entered.join("sdk").as_os_str()));
+        eprintln!("STATE cc7975-s2: {}", key(&["-fcolor-diagnostics"]));
+        let _o2 = set("OUT_DIR", Some("".as_ref()));
+        eprintln!("STATE cc7975-s3: {}", key(&["-fcolor-diagnostics"]));
+    }
+    drop((_a, _b, _c, _d));
+    drop(lock);
+}
