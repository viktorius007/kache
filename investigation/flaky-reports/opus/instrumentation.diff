+// FLAKY-INVESTIGATION instrumentation (temporary, not for commit).
+// Mimics include_dir_digest_exempts_an_existing_sdkroot_directory's env edit,
+// held under the process-state lock, toggled for FLAKY_TOGGLE_MS milliseconds.
+#[test]
+fn zz_flaky_sdkroot_toggler() {
+    let Some(ms) = std::env::var("FLAKY_TOGGLE_MS").ok().and_then(|v| v.parse::<u64>().ok()) else {
+        return;
+    };
+    let temp = tempfile::tempdir().unwrap();
+    let sdk = temp.path().join("sdk");
+    fs::create_dir(&sdk).unwrap();
+    let end = std::time::Instant::now() + std::time::Duration::from_millis(ms);
+    while std::time::Instant::now() < end {
+        let _lock = crate::test_support::process_state_test_lock();
+        unsafe { std::env::set_var("SDKROOT", &sdk) };
+        std::thread::sleep(std::time::Duration::from_millis(5));
+        unsafe { std::env::remove_var("SDKROOT") };
+        drop(_lock);
+        std::thread::sleep(std::time::Duration::from_millis(5));
+    }
+}
