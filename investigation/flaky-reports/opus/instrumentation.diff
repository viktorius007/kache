+// FLAKY-INVESTIGATION instrumentation (temporary, not for commit).
+// Toggles one env var (FLAKY_GEN_VAR=FLAKY_GEN_VAL) or, with FLAKY_GEN_CWD,
+// the current directory, under the process-state lock, for FLAKY_GEN_MS.
+#[test]
+fn zz_flaky_generic_toggler() {
+    let Some(ms) = std::env::var("FLAKY_GEN_MS").ok().and_then(|v| v.parse::<u64>().ok()) else {
+        return;
+    };
+    let var: Option<&'static str> = std::env::var("FLAKY_GEN_VAR").ok().map(|v| &*Box::leak(v.into_boxed_str()));
+    let val = std::env::var_os("FLAKY_GEN_VAL").unwrap_or_default();
+    let cwd = std::env::var_os("FLAKY_GEN_CWD").is_some();
+    let end = std::time::Instant::now() + std::time::Duration::from_millis(ms);
+    while std::time::Instant::now() < end {
+        let mut lock = crate::test_support::process_state_test_lock();
+        if cwd {
+            lock.enter();
+        }
+        let guard = var.map(|name| crate::config::tests::set_env_for_test(name, Some(val.as_os_str())));
+        std::thread::sleep(std::time::Duration::from_millis(3));
+        drop(guard);
+        drop(lock);
+        std::thread::sleep(std::time::Duration::from_millis(3));
+    }
+}
