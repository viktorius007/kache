+// FLAKY-INVESTIGATION instrumentation (temporary, not for commit).
+#[cfg(unix)]
+#[test]
+fn zz_flaky_probe_terminal_key_perturbations() {
+    if std::env::var_os("FLAKY_PROBE").is_none() {
+        return;
+    }
+    let mut lock = crate::test_support::process_state_test_lock();
+    let dir = tempfile::tempdir().unwrap();
+    let source = dir.path().join("unit.c");
+    fs::write(&source, "int x;\n").unwrap();
+    let fake_cc =
+        Path::new(env!("CARGO_MANIFEST_DIR")).join("tests/fixtures/mock_cc_diagnostics.sh");
+    let compiler = CcCompiler::new();
+    let file_hasher = crate::cache_key::FileHasher::new();
+    let path_normalizer = crate::path_normalizer::PathNormalizer::empty();
+    let parse = |flags: &[&str]| {
+        let mut args = vec![
+            fake_cc.to_string_lossy().into_owned(),
+            "-c".into(),
+            source.to_string_lossy().into_owned(),
+        ];
+        args.extend(flags.iter().map(|flag| flag.to_string()));
+        compiler.parse(&args).unwrap()
+    };
+    let key = |flags: &[&str], cache: &Path| {
+        compiler
+            .cache_key(
+                &parse(flags),
+                &KeyCtx {
+                    file_hasher: &file_hasher,
+                    path_normalizer: &path_normalizer,
+                    cache_dir: cache,
+                    key_salt: None,
+                    key_env_vars: &[],
+                    extra_inputs_digest: None,
+                    build_script_inputs_digest: None,
+                },
+            )
+            .unwrap()
+    };
+    let warm = dir.path().join("warm");
+    let baseline = key(&[], &warm);
+    eprintln!("PROBE cwd={:?} baseline={baseline}", std::env::current_dir().unwrap());
+    let mut n = 0;
+    let mut cold = || {
+        n += 1;
+        dir.path().join(format!("cold-x{n}"))
+    };
+    let vars: &[(&'static str, &str)] = &[
+        ("OUT_DIR", "/tmp/some-out-dir"),
+        ("SDKROOT", "/tmp"),
+        ("SOURCE_DATE_EPOCH", "123"),
+        ("KACHE_CC_SOURCE_DATE_EPOCH", "passthrough"),
+        ("KACHE_CC_PATH_NORMALIZE", "0"),
+        ("KACHE_BASE_DIR", "/tmp"),
+        ("CPATH", "/tmp"),
+        ("LIBRARY_PATH", "/tmp"),
+        ("LANG", "C"),
+        ("PATH", "/usr/bin:/bin"),
+        ("KACHE_CACHE_DIR", "/tmp/kc"),
+        ("KACHE_KEY_SALT", "salt"),
+        ("KACHE_KEY_ENV_VARS", "FOO"),
+        ("KACHE_CC_KEY_PROBE", "1"),
+        ("KACHE_CC_EXTRA_ALLOWLIST_FLAGS", "-fcolor-diagnostics"),
+        ("DEP_KT_INCLUDE", "/tmp"),
+        ("CARGO_MANIFEST_DIR", "/tmp"),
+    ];
+    for (name, value) in vars {
+        let _env = crate::config::tests::set_env_for_test(name, Some(value.as_ref()));
+        let c = key(&["-fcolor-diagnostics"], &cold());
+        let w = key(&["-fcolor-diagnostics"], &warm);
+        eprintln!(
+            "PROBE env {name}={value}: cold {} warm {}",
+            if c == baseline { "same" } else { "DIFF" },
+            if w == baseline { "same" } else { "DIFF" }
+        );
+    }
+    let entered = lock.enter();
+    let c = key(&["-fcolor-diagnostics"], &cold());
+    let w = key(&["-fcolor-diagnostics"], &warm);
+    eprintln!(
+        "PROBE cwd={entered:?}: cold {} ({c}) warm {} ({w})",
+        if c == baseline { "same" } else { "DIFF" },
+        if w == baseline { "same" } else { "DIFF" }
+    );
+    drop(lock);
+}
