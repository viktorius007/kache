+/// `digest`, a tree digest computed with `file_hasher`, as a guard with the
+/// walks behind it.
+fn tree_guard_of(
+    file_hasher: &FileHasher<'_>,
+    digest: impl FnOnce() -> Option<String>,
+) -> Option<TreeGuard> {
+    file_hasher.take_tree_walks();
+    let digest = digest()?;
+    Some(TreeGuard {
+        digest,
+        walks: file_hasher.take_tree_walks(),
+    })
+}
