+        let stamp = stamp_root(&root, CRATE_TREE_MAX_ENTRIES)
+            .expect("a tree to stamp")
+            .digest;
+        Self {
+            digest: digest.to_string(),
+            walks: vec![GuardWalk {
+                root,
