+        let dir = tempfile::tempdir().unwrap();
+        assert!(!holds_cargo_build_tag(dir.path()));
+        write(&dir.path().join("CACHEDIR.TAG"), "Signature: x\n");
+        assert!(!holds_cargo_build_tag(dir.path()));
