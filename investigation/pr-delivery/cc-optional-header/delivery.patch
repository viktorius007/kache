+/// Read-set fingerprints cannot validate a header that an availability probe
+/// found absent. Refuse these units instead of publishing a memo or object
+/// whose dependencies omit that existence check.
+fn cc_check_header_availability_inputs(paths: &[PathBuf]) -> Result<()> {
+    for path in paths {
+        let bytes = fs::read(path)
+            .with_context(|| format!("reading header availability input {}", path.display()))?;
+        // Conservatively join continued identifiers, including CRLF input.
+        let text: Vec<u8> = bytes
+            .into_iter()
+            .filter(|byte| !matches!(byte, b'\\' | b'\r' | b'\n'))
+            .collect();
+        anyhow::ensure!(
+            memchr::memmem::find(&text, b"__has_include").is_none(),
+            "cc: header availability probes (__has_include) have untracked dependencies"
+        );
+    }
+    Ok(())
+}
+
 /// The first construct in any of `paths` that could make the assembler read
 /// a file no fingerprint covers. The classic path scans the expansion; a
 /// compile-first key never sees one, so it scans what the compile read.
@@ -7351,6 +7371,9 @@ impl CcCompiler {
             );
             (hash, read_inputs)
         };
+        if let Some(inputs) = &read_inputs {
+            cc_check_header_availability_inputs(inputs)?;
+        }
         hasher.update(b"preprocessed:");
         hasher.update(pp_hash.as_bytes());
